.MODEL SMALL
.STACK 100H

.DATA
NUM1 DB ?
NUM2 DB ?
RESULT DB ?

.CODE
MOV AX, @DATA
MOV DS, AX


MOV AH, 01H
INT 21H
SUB AL, 30H
MOV NUM1, AL


MOV AH, 01H
INT 21H
SUB AL, 30H
MOV NUM2, AL


MOV AL, NUM1
ADD AL, NUM2
MOV RESULT, AL


ADD AL, 30H
MOV DL, AL
MOV AH, 02H
INT 21H


MOV AH, 4CH
INT 21H

END